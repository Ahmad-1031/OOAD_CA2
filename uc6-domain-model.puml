@startuml domain-model

class Customer {
  name
}

class Order {
  orderNumber
  orderDate
}

class OrderItem {
  itemNumber
  description
  status
  isPaused
  price
  expectedCompletionDate
}

class DesignVersion {
  versionNumber
  createdDate
  dimensions
  finish
  drawings
}

class Approval {
  approvalDate
  scope
  approvedParts
}

class Change {
  changeNumber
  changeDate
  description
  priceChange
  newCompletionDate
  status
  responseDate
}

class StaffMember {
  name
  role
}

Customer "1" -- "0..*" Order : places >
Order "1" -- "1..*" OrderItem : contains >
OrderItem "1" -- "0..*" DesignVersion : keeps history of >
DesignVersion "1" -- "0..*" Approval : receives >
Customer "1" -- "0..*" Approval : gives >
StaffMember "1" -- "0..*" Approval : records >
Change "0..*" -- "1" DesignVersion : is based on >
Change "0..1" -- "1" DesignVersion : results in >
StaffMember "1" -- "0..*" Change : records >

@enduml
