@startuml SSD-01-uc6-record-change
hide footbox
title SSD-01 UC6 Record Change

actor Designer
participant "Workshop Order System" as System

Designer -> System : findOrderItem(orderNumber, itemNumber)
activate System
System --> Designer : itemDetails(latestApprovedVersion, status, price, expectedCompletionDate)
deactivate System

Designer -> System : recordChange(orderNumber, itemNumber, description, dimensions, finish, drawings, priceChange, newCompletionDate)
activate System

alt item has no approved design version
  System --> Designer : refused(NO_APPROVED_VERSION)
  deactivate System

else item has an approved design version
  System --> Designer : changeRecorded(newVersionNumber, itemPaused)
  deactivate System

  alt customer agrees to the change
    Designer -> System : recordCustomerAgreement(orderNumber, itemNumber)
    activate System
    System --> Designer : changeAgreed(latestApprovedVersion, price, expectedCompletionDate)
    deactivate System

  else customer does not agree to the change
    Designer -> System : recordCustomerRejection(orderNumber, itemNumber)
    activate System
    System --> Designer : changeRejected(latestApprovedVersion, price, expectedCompletionDate)
    deactivate System
  end
end

@enduml
